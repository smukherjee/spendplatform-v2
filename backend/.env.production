# Production Environment Configuration
ENVIRONMENT=production

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=your-super-secret-production-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_HOST=your-production-db-host
DATABASE_PORT=5432
DATABASE_NAME=spendplatform_prod
DATABASE_USER=spenduser_prod
DATABASE_PASSWORD=your-secure-db-password

# Redis Configuration
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_PREFIX=/api/v1

# CORS Configuration (restrict to your frontend domains)
CORS_ORIGINS=["https://your-production-frontend.com"]

# Frontend Service Discovery
FRONTEND_URL=https://your-production-frontend.com

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=INFO

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# DO NOT SET DEVELOPMENT TEST CREDENTIALS IN PRODUCTION
# DEV_TEST_USERNAME and DEV_TEST_PASSWORD should NOT be set