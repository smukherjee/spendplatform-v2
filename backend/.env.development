# Development Environment Configuration
ENVIRONMENT=development

# Security - Development keys (NOT for production)
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=spendplatform
DATABASE_USER=spenduser
DATABASE_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_PREFIX=/api/v1

# CORS Configuration (permissive for development)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Service Discovery
FRONTEND_URL=http://localhost:3000

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=DEBUG

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Development Test Credentials (for testing only)
DEV_TEST_USERNAME=testuser
DEV_TEST_PASSWORD=testpass123
DEV_TEST_CLIENT_ID=1