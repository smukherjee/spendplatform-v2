# SYNC SERVER Environment Configuration 
# Use this configuration to connect frontend to the sync server on port 8000
# Copy this content to .env to switch to sync server

REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_SERVER_TYPE=SYNC
REACT_APP_API_TIMEOUT=5000

# Additional Configuration for Sync
REACT_APP_ENABLE_LOGGING=true
REACT_APP_ENABLE_CACHE_HEADERS=false
REACT_APP_DEFAULT_TEST_USER=user
REACT_APP_DEFAULT_TEST_PASSWORD=user123

# Development Settings
NODE_ENV=development